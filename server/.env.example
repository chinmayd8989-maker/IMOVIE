# Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/imovies
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Initial Admin Credentials (used during database seed)
ADMIN_DEFAULT_EMAIL=admin@imovies.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPassword123!

# In-Memory Database Mode (set to true for zero-setup demo/testing without external MongoDB)
USE_IN_MEMORY_DB=false
